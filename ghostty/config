font-size = 14
confirm-close-surface = false
font-family = "Maple Mono NF CN"

keybind = cmd+opt+arrow_left=previous_tab
keybind = cmd+opt+arrow_right=next_tab
keybind = shift+arrow_left=previous_tab
keybind = shift+arrow_right=next_tab
keybind = shift+enter=text:\x1b\r
keybind = global:ctrl+t=toggle_quick_terminal

keybind = cmd+e=text:c\n

clipboard-paste-protection = false
