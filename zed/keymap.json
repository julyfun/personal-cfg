[
  {
    "context": "Editor || Workspace",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
      "cmd-shift-space": "editor::ShowCompletions",
      "alt-z": "editor::ToggleSoftWrap"
    },
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      "j": ["workspace::SendKeystrokes", "g j"],
      "k": ["workspace::SendKeystrokes", "g k"],
      ";": ["workspace::SendKeystrokes", "5 g j"],
      ",": ["workspace::SendKeystrokes", "5 g k"],
      "d": ["workspace::SendKeystrokes", "\" _ d"],
      "D": ["workspace::SendKeystrokes", "\" _ D"],
      "c": ["workspace::SendKeystrokes", "\" _ c"],
      "C": ["workspace::SendKeystrokes", "\" _ C"],
      "x": ["workspace::SendKeystrokes", "\" _ x"],
      "m m": "editor::ToggleBookmark",
      "` m": "editor::ViewBookmarks",
    }
  },
  {
    "context": "Editor && vim_mode == visual && !VimWaiting && !menu",
    "bindings": {
      "j": ["workspace::SendKeystrokes", "g j"],
      "k": ["workspace::SendKeystrokes", "g k"],
      ";": ["workspace::SendKeystrokes", "5 g j"],
      ",": ["workspace::SendKeystrokes", "5 g k"],
      "d": ["workspace::SendKeystrokes", "\" _ d"],
      "c": ["workspace::SendKeystrokes", "\" _ c"],
      "<": ["workspace::SendKeystrokes", "< g v"],
      ">": ["workspace::SendKeystrokes", "> g v"],
      "ctrl-a": ["workspace::SendKeystrokes", "ctrl-a g v"],
      "ctrl-x": ["workspace::SendKeystrokes", "ctrl-x g v"],
      "J": "editor::MoveLineDown",
      "K": "editor::MoveLineUp",
    }
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      ";": ["workspace::SendKeystrokes", "5 g j"],
      ",": ["workspace::SendKeystrokes", "5 g k"],
    }
  },
  {
    "context": "Workspace || Editor",
    "bindings": {
      "ctrl-;": "editor::ToggleFocus",
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-shift-d": [
        "editor::SelectNext",
        {
          "replace_newest": false
        }
      ]
    }
  },
]
